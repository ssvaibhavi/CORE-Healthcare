# GEMINI_API_KEY: Required strictly on the server for Gemini AI API calls (/api/ai/*).
# Never prefix with VITE_ or expose in client-side code.
# - In AI Studio: set via Settings > Secrets.
# - On Netlify: set under Site Configuration > Environment variables (available to netlify/functions/api.ts).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Server-Side Multilingual Text-to-Speech Fallback (used ONLY if browser lacks native en-IN / kn-IN / te-IN voices)
# Gemini TTS (gemini-3.8-flash-lite-tts) automatically reuses GEMINI_API_KEY when available.
# Optional: set GOOGLE_CLOUD_TTS_API_KEY to prefer Google Cloud TTS, or set DISABLE_GEMINI_TTS="true" to disable Gemini TTS.
# GOOGLE_CLOUD_TTS_API_KEY="MY_GOOGLE_CLOUD_TTS_API_KEY"
# DISABLE_GEMINI_TTS="true"

